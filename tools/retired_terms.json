{
  "cutoff_decision": 83,
  "allowlist": [
    "CHANGELOG.md",
    "docs/PLAN-MVP.md",
    "docs/adr/**",
    "docs/teach-me/**",
    "docs/proposals/**",
    ".specify/**",
    "specs/**",
    "docs/governance/ASTRA-REVIEW-2.md",
    "docs/governance/FREEZE-002.md",
    "docs/governance/PLAN-BUILD-2.md",
    "docs/governance/proof/**",
    "build/**",
    "dist/**",
    "tests/fixtures/**",
    "fixtures/**",
    "skills/*/tests/**"
  ],
  "patterns": [
    {"row": "supervisor", "aliases": ["Supervisor"], "pattern": "\\bSupervisors?\\b", "replacement": "supervisor (relation) or Orchestrator (rung)"},
    {"row": "supervisor", "aliases": ["one rung up"], "pattern": "(?i)\\bone[- ]rung[- ]up\\b", "replacement": "to your supervisor, or one level up the chain"},
    {"row": "Lead", "aliases": ["Orchestrator as a Lead alias"], "pattern": "(?:aka|[Aa]lias(?:es)?:?)\\s+(?:[A-Z][\\w-]*(?:,\\s*|\\s+and\\s+|\\s+or\\s+))*Orchestrator\\b(?!\\s+rung)", "replacement": "Lead"},
    {"row": "Worker", "aliases": ["Workhorse", "Grunt"], "pattern": "(?:aka|[Aa]lias(?:es)?:?)\\s+(?:[A-Z][\\w-]*(?:,\\s*|\\s+and\\s+|\\s+or\\s+))*(?:Workhorse|Grunt)\\b(?:(?:,\\s*|\\s+and\\s+|\\s+or\\s+)(?:Workhorse|Grunt)\\b)*", "replacement": "Worker"},
    {"row": "Executive", "aliases": ["ultra-tier"], "pattern": "(?i)\\bultra[- ]tier\\b", "replacement": "Executive rung"},
    {"row": "Executive", "aliases": ["frontier"], "pattern": "(?i)\\bfrontier[- ]tier\\b", "replacement": "Executive rung"},
    {"row": "Grunt", "aliases": ["flash-tier"], "pattern": "(?i)\\bflash[- ]tier\\b", "replacement": "Grunt rung"},
    {"row": "Grunt", "aliases": ["cheap"], "pattern": "(?i)\\bcheap[- ]tier\\b", "replacement": "Grunt rung"},
    {"row": "Rung", "aliases": ["mid"], "pattern": "(?i)\\bmid[- ]tier\\b", "replacement": "Workhorse or Orchestrator rung"},
    {"row": "Rung", "aliases": ["Tier as a rung noun"], "pattern": "(?<!Free )\\bTiers?\\s*:|\\|\\s*\\*{0,2}Tiers?\\*{0,2}\\s*(?:\\||$)|\\bTiers?\\s+(?:Executive|Orchestrator|Workhorse|Grunt)\\b|\\b(?:[Tt]he|aka|alias(?:es)?) Tiers?\\b", "replacement": "Rung"},
    {"row": "CEO", "aliases": ["Owner"], "pattern": "\\b(?:[Tt]he|aka|and|alias(?:es)?) Owners?\\b|^\\s*[-*]\\s+\\*{0,2}Owners?\\b(?!:)|^\\s*[-*]\\s+\\*{0,2}Owners?:\\*{0,2}\\s*\\S|\\|\\s*\\*{1,2}Owners?\\b", "replacement": "operator"},
    {"row": "Chief of Staff (CoS)", "aliases": ["Interlocutor"], "pattern": "\\bInterlocutors?\\b", "replacement": "CoS"},
    {"row": "Chief of Staff (CoS)", "aliases": ["Driver"], "pattern": "\\b(?:[Tt]he|aka|alias(?:es)?) Drivers?\\b|^\\s*[-*]\\s+\\*{0,2}Drivers?\\b|\\|\\s*\\*{1,2}Drivers?\\b", "replacement": "CoS"}
  ]
}
