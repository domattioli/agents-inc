# <<< release-ignore:end

include LICENSE LICENSE-AI.md NOTICE README.md CHANGELOG.md CITATION.cff
recursive-include LICENSES *
recursive-include agents_inc *.json
recursive-include skills/workerbee *
recursive-include skills/codex-bridge *
include docs/governance/SCHEMA-3NF.md
global-exclude __pycache__ *.py[cod]
# The release-ignore block prunes tests/ and demo/ at the root only; the shipped skills carry their own.
